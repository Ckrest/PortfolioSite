#!/usr/bin/env bash
set -euo pipefail
: "${CONSTELLATION_NATIVE_ROOT:?CONSTELLATION_NATIVE_ROOT is required}"
: "${PORTFOLIO_SITE_RELEASE_REQUEST:?PORTFOLIO_SITE_RELEASE_REQUEST is required}"
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SITE_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
NODE_BIN="${PORTFOLIO_SITE_NODE:-$(command -v node)}"
REQUEST_PATH="$(readlink -f "$PORTFOLIO_SITE_RELEASE_REQUEST")"
jq -e '.schema == "portfolio-site/release-input@2" and (.release_revision > 0) and .snapshot.schema == "portfolio-site/accepted-snapshot@2"' "$REQUEST_PATH" >/dev/null
ARTIFACT_ROOT="$(jq -er '.artifact_root' "$REQUEST_PATH")"
VERIFICATION="$(mktemp)"
trap 'rm -f "$VERIFICATION"' EXIT
"$NODE_BIN" "$SITE_ROOT/updates/_release-build.js" --verify-output "$ARTIFACT_ROOT" >"$VERIFICATION"
jq -e --slurpfile request "$REQUEST_PATH" '.valid and .receipt.release_revision == $request[0].release_revision and .receipt.snapshot_digest == $request[0].snapshot.digest and .receipt.site_source_digest == $request[0].site_source_digest' "$VERIFICATION" >/dev/null
OUTPUT_ROOT="$CONSTELLATION_NATIVE_ROOT/stage/portfolio-site"
rm -rf -- "$OUTPUT_ROOT"
mkdir -p "$OUTPUT_ROOT"
# Compilation already finished under the claimed release. Native installation
# materializes those exact immutable bytes; it does not compile them again.
cp -a --reflink=auto "$ARTIFACT_ROOT/." "$OUTPUT_ROOT/"
"$NODE_BIN" "$SITE_ROOT/updates/_release-build.js" --verify-output "$OUTPUT_ROOT" >/dev/null
