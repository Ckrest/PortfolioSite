#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SITE_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
ACTIVE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/portfolio-site/active"
NODE_BIN="${PORTFOLIO_SITE_NODE:-}"
if [[ -z "$NODE_BIN" ]]; then
  NODE_BIN="$(command -v node || true)"
fi
if [[ -z "$NODE_BIN" || ! -x "$NODE_BIN" ]]; then
  echo "Portfolio Site validation requires Node.js 20 or newer." >&2
  exit 1
fi

pool_response="$(mktemp)"
verification="$(mktemp)"
cleanup() {
  rm -f "$pool_response" "$verification"
}
trap cleanup EXIT

portfolio-editor-cli pool-get >"$pool_response"
jq -e '
  .ok == true
  and .data.schema == "portfolio-editor/accepted-pool@4"
  and .data.revision > 0
  and (.data.bundle.id | type == "string" and length > 0)
' "$pool_response" >/dev/null

"$NODE_BIN" "$SITE_ROOT/updates/_pool-build.js" --verify-output "$ACTIVE_ROOT" \
  >"$verification"

jq -e --slurpfile pool "$pool_response" '
  .valid == true
  and .receipt.pool_revision == $pool[0].data.revision
  and .receipt.pool_digest == $pool[0].data.digest
  and .receipt.approval_bundle_id == $pool[0].data.bundle.id
  and .receipt.approval_manifest_digest == $pool[0].data.bundle.manifest_digest
  and .receipt.site_source_digest == $pool[0].data.bundle.site_source_digest
  and .receipt.public_source_digest == $pool[0].data.bundle.public_source_digest
  and .receipt.result_digest == $pool[0].data.bundle.result_digest
  and any(
    $pool[0].data.handoffs[];
    .pool_revision == $pool[0].data.revision
    and .bundle_id == $pool[0].data.bundle.id
    and .state == "realized"
    and .result_digest == $pool[0].data.bundle.result_digest
  )
' "$verification" >/dev/null

revision="$(jq -er '.data.revision' "$pool_response")"
digest="$(jq -er '.data.digest' "$pool_response")"
printf 'accepted_pool=R%s %s\n' "$revision" "$digest"
