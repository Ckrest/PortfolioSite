      "icon": "📋",
      "description": "Embedded PDF viewer",
      "hint": "Click to set PDF source",
      "fields": ["src", "caption", "evidenceQualifier"],
      "allowInGroup": true,
      "contract": {
        "allowEmptySave": true,
        "renderRequiredAll": ["src"],
        "renderRequiredAny": [],
        "skipRenderIfIncomplete": true,
        "fillMethods": ["text-input", "file-attach", "drag-drop"]
      }
    },
    {
      "type": "group",
      "label": "Group",
