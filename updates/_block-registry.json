    },
    {
      "type": "mermaid",
      "label": "Mermaid",
      "icon": "🧩",
      "description": "Mermaid diagram",
      "hint": "Click to add Mermaid diagram",
      "fields": ["sourceMode", "src", "code", "caption", "evidenceQualifier"],
      "allowInGroup": true,
      "contract": {
        "allowEmptySave": true,
