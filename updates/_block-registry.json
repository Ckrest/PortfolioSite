        "fillMethods": ["add-child"]
      }
    },
    {
      "type": "code",
      "label": "Code",
      "icon": "💻",
      "description": "Code with syntax highlighting",
      "hint": "Click to add code",
      "fields": ["sourceMode", "language", "filename", "src", "code", "caption", "evidenceQualifier"],
      "allowInGroup": true,
      "contract": {
